# ==========================================
# LegacyLens AI - Environment Configuration
# ==========================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API Configuration
# Optional: Set your Gemini API key to enable generative explanations,
# architectural modernization assessments, and AI-suggested regression tests.
# If not provided, LegacyLens AI runs completely in static heuristic mode without failure.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000

