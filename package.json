{
  "name": "legacylens-ai",
  "version": "1.0.0",
  "description": "Autonomous Legacy Modernization Agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --names \"frontend,backend\" -c \"cyan.bold,magenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node scripts/start-backend.js",
    "build": "npm run build --prefix frontend",
    "test:backend": "python -m pytest backend/tests -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

