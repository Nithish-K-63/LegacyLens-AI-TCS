<?xml version="1.0" encoding="UTF-8"?>
<definitions name="WarehouseReservationService"
    targetNamespace="http://legacy.northstar.com/warehouse"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://legacy.northstar.com/warehouse"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <message name="ReservationRequest">
        <part name="reservationKey" type="xsd:string"/>
        <part name="sku" type="xsd:string"/>
        <part name="quantity" type="xsd:int"/>
        <part name="timeoutMillis" type="xsd:int"/>
    </message>

    <message name="ReservationResponse">
        <part name="status" type="xsd:string"/>
        <part name="confirmationCode" type="xsd:string"/>
    </message>

    <portType name="ReservationPortType">
        <operation name="ReserveInventory">
            <input message="tns:ReservationRequest"/>
            <output message="tns:ReservationResponse"/>
        </operation>
    </portType>

    <binding name="ReservationBinding" type="tns:ReservationPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="ReserveInventory">
            <soap:operation soapAction="ReserveInventory"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="WarehouseReservationService">
        <port name="ReservationPort" binding="tns:ReservationBinding">
            <soap:address location="http://warehouse-internal.corp/soap/v1"/>
        </port>
    </service>
</definitions>

